          {"name": "api-server-7d4b8c6f9-x2k1p", "namespace": "myapp", "status": "Running", "ready": "1/1", "restarts": 0, "node": "worker-0.ocp-lab.example.com", "age": "5d"},
          {"name": "web-frontend-5b9c7d8e4f-abc12", "namespace": "myapp", "status": "Running", "ready": "1/1", "restarts": 0, "node": "worker-1.ocp-lab.example.com", "age": "5d"},
          {"name": "prometheus-k8s-0", "namespace": "openshift-monitoring", "status": "Running", "ready": "3/3", "restarts": 0, "node": "worker-0.ocp-lab.example.com", "age": "30d"}
