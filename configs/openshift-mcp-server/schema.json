{
  "name": "openshift-mcp-server",
  "version": "1.0.0",
  "description": "Mock schema for the OpenShift MCP Server (core + config toolsets). Covers cluster resource management, pod operations, node metrics, and configuration.",
  "tools": [
    {
      "name": "configuration_contexts_list",
      "description": "List all available context names and associated server urls from the kubeconfig file.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "contexts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {"type": "string"},
                "cluster": {"type": "string"},
                "user": {"type": "string"},
                "server": {"type": "string"}
              }
            }
          },
          "current_context": {"type": "string"}
        }
      },
      "outputExample": {
        "contexts": [
          {"name": "default/api-ocp-lab-example-com:6443/admin", "cluster": "api-ocp-lab-example-com:6443", "user": "admin", "server": "https://api.ocp-lab.example.com:6443"},
          {"name": "staging/api-ocp-staging-example-com:6443/developer", "cluster": "api-ocp-staging-example-com:6443", "user": "developer", "server": "https://api.ocp-staging.example.com:6443"}
        ],
        "current_context": "default/api-ocp-lab-example-com:6443/admin"
      }
    },
    {
      "name": "configuration_view",
      "description": "Get the current Kubernetes configuration content as a kubeconfig YAML.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "minified": {"type": "boolean", "description": "Return a minified version keeping only the current-context and relevant config. Default true."}
        },
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "kubeconfig": {"type": "string", "description": "YAML content of the kubeconfig"}
        }
      },
      "outputExample": {
        "kubeconfig": "apiVersion: v1\nclusters:\n- cluster:\n    server: https://api.ocp-lab.example.com:6443\n  name: api-ocp-lab-example-com:6443\ncontexts:\n- context:\n    cluster: api-ocp-lab-example-com:6443\n    namespace: default\n    user: admin\n  name: default/api-ocp-lab-example-com:6443/admin\ncurrent-context: default/api-ocp-lab-example-com:6443/admin\nkind: Config\n"
      }
    },
    {
      "name": "events_list",
      "description": "List all the Kubernetes events in the current cluster. Can be filtered by namespace.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "namespace": {"type": "string", "description": "Namespace to retrieve events from. If not provided, lists events from all namespaces."}
        },
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "namespace": {"type": "string"},
                "name": {"type": "string"},
                "type": {"type": "string", "enum": ["Normal", "Warning"]},
                "reason": {"type": "string"},
                "message": {"type": "string"},
                "object": {"type": "string"},
                "last_seen": {"type": "string", "format": "date-time"}
              }
            }
          }
        }
      },
      "outputExample": {
        "events": [
          {"namespace": "myapp", "name": "api-server-7d4b8c6f9-x2k1p.event1", "type": "Normal", "reason": "Pulled", "message": "Successfully pulled image", "object": "Pod/api-server-7d4b8c6f9-x2k1p", "last_seen": "2026-09-07T09:00:00Z"},
          {"namespace": "openshift-monitoring", "name": "prometheus-k8s-0.event1", "type": "Normal", "reason": "Started", "message": "Started container prometheus", "object": "Pod/prometheus-k8s-0", "last_seen": "2026-09-07T09:00:00Z"}
        ]
      }
    },
    {
      "name": "namespaces_list",
      "description": "List all the Kubernetes namespaces in the current cluster.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "namespaces": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {"type": "string"},
                "status": {"type": "string", "enum": ["Active", "Terminating"]},
                "labels": {"type": "object"}
              }
            }
          }
        }
      },
      "outputExample": {
        "namespaces": [
          {"name": "default", "status": "Active", "labels": {}},
          {"name": "myapp", "status": "Active", "labels": {"app": "myapp", "env": "production"}},
          {"name": "openshift-monitoring", "status": "Active", "labels": {}},
          {"name": "openshift-ingress", "status": "Active", "labels": {}},
          {"name": "kube-system", "status": "Active", "labels": {}}
        ]
      }
    },
    {
      "name": "nodes_log",
      "description": "Get logs from a Kubernetes node (kubelet, kube-proxy, or other system logs).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "description": "Name of the node to get logs from."},
          "query": {"type": "string", "description": "Service or file to return logs from (e.g. 'kubelet', '/var/log/kube-proxy.log')."},
          "tailLines": {"type": "integer", "description": "Number of lines from the end of the logs. 0 means all.", "default": 100}
        },
        "required": ["name", "query"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "node": {"type": "string"},
          "query": {"type": "string"},
          "logs": {"type": "string"}
        }
      },
      "outputExample": {
        "node": "worker-0.ocp-lab.example.com",
        "query": "kubelet",
        "logs": "Sep 07 09:00:01 worker-0 kubelet[1523]: I0907 09:00:01.123456 1523 kubelet.go:2345] SyncLoop (PLEG): \"myapp/api-server-7d4b8c6f9-x2k1p\" in running state\nSep 07 09:00:02 worker-0 kubelet[1523]: I0907 09:00:02.234567 1523 kubelet.go:2401] SyncLoop (SYNC): 12 pods, 12 running\n"
      }
    },
    {
      "name": "nodes_stats_summary",
      "description": "Get detailed resource usage statistics from a node via the kubelet Summary API.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "description": "Name of the node to get stats from."}
        },
        "required": ["name"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "node_name": {"type": "string"},
          "cpu": {"type": "object", "properties": {"usage_nano_cores": {"type": "integer"}, "usage_core_nano_seconds": {"type": "integer"}}},
          "memory": {"type": "object", "properties": {"available_bytes": {"type": "integer"}, "usage_bytes": {"type": "integer"}, "working_set_bytes": {"type": "integer"}}},
          "fs": {"type": "object", "properties": {"available_bytes": {"type": "integer"}, "capacity_bytes": {"type": "integer"}, "used_bytes": {"type": "integer"}}},
          "pods_count": {"type": "integer"}
        }
      },
      "outputExample": {
        "node_name": "worker-0.ocp-lab.example.com",
        "cpu": {"usage_nano_cores": 1250000000, "usage_core_nano_seconds": 45678901234567},
        "memory": {"available_bytes": 8589934592, "usage_bytes": 25769803776, "working_set_bytes": 24696061952},
        "fs": {"available_bytes": 107374182400, "capacity_bytes": 214748364800, "used_bytes": 96636764160},
        "pods_count": 42
      }
    },
    {
      "name": "nodes_top",
      "description": "List node resource consumption (CPU and memory) from Metrics Server.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "description": "Name of the node. All nodes if not provided."},
          "label_selector": {"type": "string", "description": "Label selector to filter nodes (e.g. 'node-role.kubernetes.io/worker=')."}
        },
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {"type": "string"},
                "cpu_usage": {"type": "string"},
                "cpu_percent": {"type": "string"},
                "memory_usage": {"type": "string"},
                "memory_percent": {"type": "string"}
              }
            }
          }
        }
      },
      "outputExample": {
        "nodes": [
          {"name": "master-0.ocp-lab.example.com", "cpu_usage": "850m", "cpu_percent": "21%", "memory_usage": "6144Mi", "memory_percent": "48%"},
          {"name": "worker-0.ocp-lab.example.com", "cpu_usage": "1600m", "cpu_percent": "40%", "memory_usage": "16Gi", "memory_percent": "50%"},
          {"name": "worker-1.ocp-lab.example.com", "cpu_usage": "1400m", "cpu_percent": "35%", "memory_usage": "14Gi", "memory_percent": "44%"}
        ]
      }
    },
    {
      "name": "pods_delete",
      "description": "Delete a pod in a specified namespace.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "description": "Name of the pod to delete."},
          "namespace": {"type": "string", "description": "Namespace to delete the pod from."}
        },
        "required": ["name"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "namespace": {"type": "string"},
          "status": {"type": "string"}
        }
      },
      "outputExample": {
        "name": "api-server-7d4b8c6f9-x2k1p",
        "namespace": "myapp",
        "status": "deleted"
      }
    },
    {
      "name": "pods_exec",
      "description": "Execute a command in a pod container.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "description": "Name of the pod."},
          "namespace": {"type": "string", "description": "Namespace of the pod."},
          "command": {"type": "array", "items": {"type": "string"}, "description": "Command to execute. First item is the command, rest are arguments."},
          "container": {"type": "string", "description": "Container name (optional)."}
        },
        "required": ["name", "command"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "stdout": {"type": "string"},
          "stderr": {"type": "string"},
          "exit_code": {"type": "integer"}
        }
      },
      "outputExample": {
        "stdout": "total 24\ndrwxr-xr-x 2 root root 4096 Sep  7 08:00 bin\ndrwxr-xr-x 2 root root 4096 Sep  7 08:00 etc\n",
        "stderr": "",
        "exit_code": 0
      }
    },
    {
      "name": "pods_get",
      "description": "Get details of a specific pod.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "description": "Name of the pod."},
          "namespace": {"type": "string", "description": "Namespace to get the pod from."}
        },
        "required": ["name"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "namespace": {"type": "string"},
          "status": {"type": "string"},
          "node": {"type": "string"},
          "ip": {"type": "string"},
          "containers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {"type": "string"},
                "image": {"type": "string"},
                "ready": {"type": "boolean"},
                "restart_count": {"type": "integer"},
                "state": {"type": "string"},
                "last_termination_reason": {"type": "string"}
              }
            }
          },
          "labels": {"type": "object"},
          "created_at": {"type": "string", "format": "date-time"}
        }
      },
      "outputExample": {
        "name": "api-server-7d4b8c6f9-x2k1p",
        "namespace": "myapp",
        "status": "Running",
        "node": "worker-0.ocp-lab.example.com",
        "ip": "10.128.2.45",
        "containers": [
          {"name": "api-server", "image": "registry.example.com/myapp/api-server:v2.3.1", "ready": true, "restart_count": 0, "state": "running", "last_termination_reason": ""}
        ],
        "labels": {"app": "api-server", "version": "v2.3.1"},
        "created_at": "2026-09-07T08:00:00Z"
      }
    },
    {
      "name": "pods_list",
      "description": "List all pods in the cluster from all namespaces.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "labelSelector": {"type": "string", "description": "Label selector to filter pods (e.g. 'app=myapp,env=prod')."},
          "fieldSelector": {"type": "string", "description": "Field selector to filter pods (e.g. 'status.phase=Running')."}
        },
        "required": []
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "pods": {
            "type": "array",
